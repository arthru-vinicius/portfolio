# Variáveis do servidor para rodar localmente: copie para .env.local se quiser
# mudar algo. Em produção, quem define estas variáveis é o servidor.

# Banco SQLite. Fora de produção, o padrão já é este caminho.
DATABASE_PATH=.data/portfolio.db

# Commit da imagem, exposto no /api/health. Fica vazio fora do container.
GIT_SHA=

# Status do último deploy, gravado pelo servidor. Fica vazio fora dele.
DEPLOY_STATUS_FILE=

# Origem canônica do site, de onde saem as URLs absolutas. No next dev, o
# padrão já é este endereço.
PUBLIC_ORIGIN=http://localhost:3000

# Só "true" deixa os buscadores indexarem, e só no host do PUBLIC_ORIGIN.
# Qualquer outro valor mantém o noindex em tudo.
ALLOW_INDEXING=false

# Painel (/admin). Sem estas variáveis, ele responde 503: nenhum segredo tem
# valor padrão. Para o next dev, preencha no .env.local, com o hash de uma senha
# local gerado por `npm run --silent admin:hash-password`. No servidor, os
# valores são segredos.
# ADMIN_HOSTS=localhost,127.0.0.1 (o padrão no next dev)
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# 32 caracteres ou mais.
ADMIN_SESSION_SECRET=

# Secret de teste da Cloudflare, que sempre aceita o token. Fora de produção, a
# site key de teste já é o padrão. Nunca use a chave real fora do servidor.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Formulário de contato. A mensagem vai para o relay de e-mail, que entrega ao
# dono do site; o relay só aceita o IP do servidor. Fora de produção, sem estas
# variáveis, o envio só vai para o log. Em produção, sem elas, o formulário fica
# desligado e o site mostra só o e-mail. O TURNSTILE_SECRET_KEY acima vale
# também para o contato.
MAIL_RELAY_URL=
MAIL_RELAY_TOKEN=
# "true" força o envio só para o log, mesmo em produção (o e2e usa).
MAIL_RELAY_DRY_RUN=
